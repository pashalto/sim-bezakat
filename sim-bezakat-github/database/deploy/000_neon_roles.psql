\set ON_ERROR_STOP on
-- FRESH Neon installation only. Connect as the Neon project admin over a DIRECT endpoint.
-- Never run against an existing database/roles with the same names.
BEGIN;
DO $$ BEGIN
 IF EXISTS(SELECT 1 FROM pg_database WHERE datname='sim_bezakat_dev')
 OR EXISTS(SELECT 1 FROM pg_roles WHERE rolname IN ('sim_bezakat_migrator','sim_bezakat_app')) THEN
   RAISE EXCEPTION 'Database or roles already exist. Stop and inspect; do not overwrite.';
 END IF;
END $$;
CREATE ROLE sim_bezakat_migrator LOGIN NOSUPERUSER NOCREATEDB NOCREATEROLE NOREPLICATION NOBYPASSRLS NOINHERIT;
CREATE ROLE sim_bezakat_app LOGIN NOSUPERUSER NOCREATEDB NOCREATEROLE NOREPLICATION NOBYPASSRLS NOINHERIT;
COMMIT;
-- Membership is needed by the creator for CREATE DATABASE ... OWNER, not by the app.
SELECT format('GRANT sim_bezakat_migrator TO %I',current_user) \gexec
CREATE DATABASE sim_bezakat_dev OWNER sim_bezakat_migrator;
SELECT format('REVOKE sim_bezakat_migrator FROM %I',current_user) \gexec
ALTER ROLE sim_bezakat_app SET statement_timeout='10s';
ALTER ROLE sim_bezakat_app SET lock_timeout='5s';
ALTER ROLE sim_bezakat_app SET idle_in_transaction_session_timeout='25s';
\password sim_bezakat_migrator
\password sim_bezakat_app
\echo 'Roles created. Use strong unique passwords accepted by Neon. Keep them outside Git.'
\echo 'Reconnect DIRECTLY as sim_bezakat_migrator to sim_bezakat_dev; run 001-007 and deployment SQL 008.'
