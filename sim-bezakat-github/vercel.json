{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": null,
  "buildCommand": "",
  "installCommand": "",
  "outputDirectory": ".",
  "functions": {
    "api/index.php": {
      "runtime": "vercel-php@0.9.0",
      "maxDuration": 30,
      "excludeFiles": "{.git/**,.vercel/**,.env,.env.*,storage/**,tests/**,tools/**,database/**,docs/**,node_modules/**,vendor/**,*.md}"
    }
  },
  "routes": [
    { "src": "/assets/(.*)", "dest": "/public/assets/$1" },
    { "src": "/(favicon\\.svg|logo-bezakat\\.png)", "dest": "/public/$1" },
    { "src": "/(?:index\\.php)?", "dest": "/api/index.php?__route=page" },
    { "src": "/api\\.php", "dest": "/api/index.php?__route=api" },
    { "src": "/api/portal/(login|logout|session|drafts|reviews|receipt)/?", "dest": "/api/index.php?__route=api&action=$1" },
    { "src": "/export\\.php", "dest": "/api/index.php?__route=export" },
    { "src": "/api/index\\.php", "dest": "/api/index.php" },
    { "src": "/.*", "status": 404 }
  ]
}
